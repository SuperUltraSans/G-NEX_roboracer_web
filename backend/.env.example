APP_ENV=development            # development | production
DATABASE_URL=sqlite:///./data/roboracer.db
SESSION_TTL_HOURS=12
COOKIE_SECURE=false            # HTTPS 환경에서 true
COOKIE_PATH=/                  # 서브패스 배포 시 그 경로 (예: /roboracer)
EVENT_TIMEZONE=Asia/Seoul
FRONTEND_DIST=../frontend/dist # 존재하면 FastAPI가 정적 파일 제공
# 규칙 그림(올린 ZIP 에서 꺼낸 것)은 RULES_DIR/files/ 에 저장된다. 어느 본문도 쓰지 않는 그림은 다음 올리기 때 지운다.
RULES_DIR=./data/rules         # 규칙 Markdown 문서(rules.ko.md, rules.en.md) 폴더. 직접 고친 뒤에는 app.cli import-rules 로 반영
CORS_ORIGINS=                  # 기본 비움 (같은 origin 운영). 쉼표로 구분
LOG_LEVEL=info
# 검색엔진용 공개 주소(끝에 /). 정하면 대표 주소(canonical)·사이트맵을 낸다
# PUBLIC_URL=https://example.com/roboracer/
# 구글 서치 콘솔·네이버 서치어드바이저 소유 확인 meta 태그의 content 값
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=
